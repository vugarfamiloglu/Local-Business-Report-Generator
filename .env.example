# Tally — environment template
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.

# Lock-screen passcode (bcrypt hash). Default if empty: tally-2026
# Generate: node -e "console.log(require('bcryptjs').hashSync('your-passcode', 10))"
TALLY_PASSCODE_HASH=

# AES-256-GCM vault key (base64-encoded 32 bytes). Encrypts provider API keys.
# Auto-generated to data/.vault-key (mode 0600) on first boot if empty.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TALLY_VAULT_KEY=

# HMAC secret for signing the session cookie. Generate the same way as the vault key.
TALLY_SESSION_SECRET=

# Optional: override the SQLite file path (default: ./data/tally.db)
TALLY_DB_PATH=
